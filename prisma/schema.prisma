generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  status    String   @default("Unread") // Unread, Read, Responded, Archived
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isRead])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  name        String
  isActive    Boolean      @default(true)
  isAdmin     Boolean      @default(false)
  isOwner     Boolean      @default(false)
  role        String       @default("MEMBER") // OWNER, ADMIN, TRAINER, STAFF, MEMBER
  createdAt   DateTime     @default(now())
  scans       ScanResult[]
  dietPlans   DietPlan[]
  memberships Membership[]
  profile     UserProfile?
  waterLogs   WaterLog[]
  weightLogs  WeightLog[]
  mealLogs    MealLog[]
  chatLogs    DietChatLog[]
  phone       String        @default("")
  attendances Attendance[]
  attendanceLogs AttendanceLog[]
  reminderLogs ReminderLog[]

  currentSessionId String?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  lastLoginUA      String?

  referralCode       ReferralCode?
  referralsCreated   Referral[]         @relation("Referrer")
  referralReceived   Referral?          @relation("Referred")
  referralRewards    ReferralReward[]
  referralActivities ReferralActivity[]
  notifications      Notification[]

  staff              Staff?
  clientIncentives   Incentive[]        @relation("ClientIncentive")
  assignedAsClient   TrainerClient[]    @relation("AssignedClient")

  adminPermissions   AdminPermission[]
  complaints         Complaint[]
  workoutPlans       WorkoutPlan[]

  @@map("users")
}

model DietPlan {
  id              Int      @id @default(autoincrement())
  userId          Int
  goal            String
  preference      String
  calories        Int
  protein         Float
  carbs           Float
  fat             Float
  meals           String   // JSON string storing the meals array
  height          Float?
  weight          Float?
  age             Int?
  activityLevel   String?
  allergies       String?
  createdAt       DateTime @default(now())

  // Upgraded Fields
  isLocked                   Boolean  @default(false)
  isManual                   Boolean  @default(false)
  trainerNotes               String?
  budget                     String?
  groceryList                String?  // JSON string
  supplementRecommendations  String?  // JSON string
  waterGoal                  Float?
  fiber                      Float?
  sugar                      Float?
  micronutrients             String?  // JSON string

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("diet_plans")
}

model ScanResult {
  id           Int      @id @default(autoincrement())
  userId       Int
  bodyFat      Float?
  muscleMass   Float?
  postureScore Float?
  workoutPlan  String?
  dietPlan     String?
  feedback     String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("scan_results")
}

model Membership {
  id                     Int       @id @default(autoincrement())
  membershipId           String    @unique // e.g. MEM-XXXXXX
  userId                 Int
  plan                   String    // Monthly, Quarterly (3 Months), Half Yearly (6 Months), Yearly, Custom
  startDate              DateTime
  endDate                DateTime
  duration               String    // e.g. "30 Days"
  status                 String    // Active, Expired, Upcoming, Frozen, Cancelled
  joinDate               DateTime  @default(now())
  renewalDate            DateTime
  expiryDate             DateTime
  paymentStatus          String    // Paid, Pending, Partial
  paymentMode            String    // Cash, UPI, Card, Bank Transfer
  amountPaid             Float
  totalAmount            Float
  discount               Float     @default(0)
  remainingBalance       Float     @default(0)
  personalTrainerIncluded Boolean   @default(false)
  ptStartDate            DateTime?
  ptEndDate              DateTime?
  ptTrainerName          String?
  notes                  String?
  remarks                String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([createdAt])
  @@index([remainingBalance])
  @@map("memberships")
}

model UserProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  age                Int
  gender             String
  height             Float
  currentWeight      Float
  targetWeight       Float
  bodyFat            Float?
  bmi                Float?
  activityLevel      String
  workoutFrequency   Int?     // e.g. times per week
  workoutTiming      String?  // e.g. "Morning", "Evening"
  fitnessGoal        String   // "weight-loss", "fat-loss", "muscle-gain", "lean-bulk", "body-recomp", "maintain"
  
  // Health conditions (comma-separated)
  healthConditions   String?  // e.g. "diabetes,thyroid,pcos"
  allergies          String?  // e.g. "peanuts,dairy"
  
  // Diet Preferences
  preference         String   // "veg", "vegan", "eggitarian", "non-veg"
  restrictions       String?  // e.g. "jain,halal,no-beef,no-pork"
  excludedFoods      String?  // JSON array of strings
  
  // Budget & Timings
  budget             String?  // "50", "100", "150", "250", "500", "1000", "no-limit"
  wakeUpTime         String?
  breakfastTime      String?
  midMorningTime     String?
  lunchTime          String?
  eveningSnackTime   String?
  dinnerTime         String?
  bedtimeMealTime    String?
  
  // Reminders JSON config
  remindersEnabled   String?  // e.g. '{"breakfast":true,"lunch":true,"dinner":true,"water":true}'
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_profiles")
}

model WaterLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float    // in ml
  date      String   // stored as YYYY-MM-DD
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("water_logs")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  weight    Float
  bmi       Float?
  bodyFat   Float?
  waist     Float?
  chest     Float?
  arms      Float?
  thighs    Float?
  date      String   // stored as YYYY-MM-DD
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("weight_logs")
}

model MealLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  dietPlanId Int
  mealName   String   // e.g. "Breakfast"
  status     String   // "completed", "skipped"
  date       String   // YYYY-MM-DD
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("meal_logs")
}

model DietChatLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("diet_chat_logs")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String   // YYYY-MM-DD
  time      String   // HH:MM:SS
  status    String   // "Present" | "Absent"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendances")
}

model AttendanceLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String   // "Marked Present (Self)", "Marked Present (Admin)", "Marked Absent (Auto)", "Deleted (Admin)", "Manually Marked Absent (Admin)"
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("attendance_logs")
}

model ReminderLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  status       String   // "Sent", "Failed"
  errorMessage String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reminder_logs")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("referral_codes")
}

model Referral {
  id              Int              @id @default(autoincrement())
  referrerId      Int
  referrer        User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId      Int              @unique
  referred        User             @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  codeUsed        String
  joinDate        DateTime         @default(now())
  status          String           @default("Pending") // Pending, Joined, Membership Activated, Completed, Rejected, Cancelled, Expired
  rewardStatus    String           @default("None") // None, Pending, Claimed, N/A
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activities      ReferralActivity[]
  rewards         ReferralReward[]

  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}

model ReferralReward {
  id          Int      @id @default(autoincrement())
  referralId  Int?
  referral    Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardName  String   // e.g. "Reward A"
  rewardType  String   // Free Membership Days, Cash Reward, Discount, Gift, Coupon, Custom Reward
  rewardValue String
  status      String   @default("Pending") // Pending, Claimed, Cancelled, Sent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([referralId])
  @@map("referral_rewards")
}

model ReferralActivity {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  referralId   Int?
  referral     Referral? @relation(fields: [referralId], references: [id], onDelete: Cascade)
  activityType String   // e.g., CODE_GENERATED, REFERRAL_JOINED, REWARD_EARNED, STATUS_UPDATED
  details      String
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([referralId])
  @@map("referral_activities")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model Staff {
  id               Int            @id @default(autoincrement())
  userId           Int?           @unique
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String         @default("")
  photo            String?
  designation      String         // Owner, Admin, Manager, Head Trainer, Personal Trainer, Receptionist, Sales Executive, Housekeeping, Other Staff
  department       String         // Management, Fitness, Operations, Sales, Maintenance, Administrative
  joiningDate      DateTime       @default(now())
  employmentStatus String         @default("Active") // Active, Inactive, On Leave, Terminated
  monthlySalary    Float          @default(0)
  workingHours     String         @default("9:00 AM - 6:00 PM")
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  salaries         StaffSalary[]
  incentives       Incentive[]
  trainerClients   TrainerClient[] @relation("TrainerRel")

  @@map("staff")
}

model StaffSalary {
  id              Int      @id @default(autoincrement())
  staffId         Int
  staff           Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month           String   // e.g. "August" or "2026-08"
  year            Int
  baseSalary      Float
  incentiveAmount Float    @default(0)
  otherPayment    Float    @default(0)
  totalPayable    Float
  paymentStatus   String   @default("Pending") // Paid, Pending
  paymentDate     DateTime?
  paymentMethod   String?  // Cash, Bank Transfer, UPI, Cheque
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([staffId])
  @@index([year, month])
  @@index([paymentStatus])
  @@map("staff_salaries")
}

model Incentive {
  id            Int      @id @default(autoincrement())
  staffId       Int
  staff         Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  incentiveType String   // Membership Conversion, Renewal, PT Session, Sales Performance, Manual Bonus
  amount        Float
  reason        String
  clientId      Int?
  client        User?    @relation("ClientIncentive", fields: [clientId], references: [id], onDelete: SetNull)
  membershipId  Int?
  month         String
  year          Int
  paymentStatus String   @default("Pending") // Paid, Pending
  paymentDate   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([staffId])
  @@index([year, month])
  @@index([paymentStatus])
  @@map("incentives")
}

model TrainerClient {
  id           Int       @id @default(autoincrement())
  trainerId    Int
  trainer      Staff     @relation("TrainerRel", fields: [trainerId], references: [id], onDelete: Cascade)
  clientId     Int
  client       User      @relation("AssignedClient", fields: [clientId], references: [id], onDelete: Cascade)
  status       String    @default("Active") // Active, Expired, Completed, FollowUpRequired
  assignedDate DateTime  @default(now())
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([trainerId])
  @@index([clientId])
  @@map("trainer_clients")
}

model Expense {
  id            Int      @id @default(autoincrement())
  category      String   // Rent, Electricity, Water, Internet, Staff Salary, Trainer Incentives, Equipment, Maintenance, Cleaning, Marketing, Advertising, Software Subscriptions, Repairs, Other Expenses
  amount        Float
  date          DateTime @default(now())
  month         String   // YYYY-MM
  year          Int
  paymentStatus String   @default("Paid") // Paid, Pending
  paymentMode   String   @default("Cash") // Cash, UPI, Card, Bank Transfer, Cheque
  description   String
  receiptUrl    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([year, month])
  @@index([paymentStatus])
  @@index([date])
  @@map("expenses")
}

model RentPayment {
  id            Int      @id @default(autoincrement())
  month         String   // YYYY-MM
  year          Int
  monthlyRent   Float
  landlordInfo  String?  // Name, Contact, Property details
  dueDate       DateTime
  paymentDate   DateTime?
  paymentStatus String   @default("Pending") // Paid, Pending, Partial
  amountPaid    Float    @default(0)
  pendingAmount Float    @default(0)
  paymentMethod String   @default("Bank Transfer")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([year, month])
  @@index([paymentStatus])
  @@map("rent_payments")
}

model ElectricityBill {
  id            Int      @id @default(autoincrement())
  month         String   // YYYY-MM
  year          Int
  billAmount    Float
  dueDate       DateTime
  paymentDate   DateTime?
  paymentStatus String   @default("Pending") // Paid, Pending
  meterReading  String?
  provider      String?
  billNumber    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([year, month])
  @@index([paymentStatus])
  @@map("electricity_bills")
}

model GymRevenue {
  id          Int      @id @default(autoincrement())
  category    String   // Membership, Personal Training, Renewals, Referral Commission, Other
  amount      Float
  source      String?  // Client Name, Online, Direct
  date        DateTime @default(now())
  month       String   // YYYY-MM
  year        Int
  paymentMode String   @default("Cash")
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year, month])
  @@index([date])
  @@map("gym_revenues")
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  action           String   // USER_DELETED, USER_EDITED, STAFF_ADDED, STAFF_REMOVED, SALARY_CHANGED, SALARY_PAID, INCENTIVE_ADDED, REFERRAL_TOGGLED, EXPENSE_ADDED, REVENUE_ADDED, MEMBERSHIP_MODIFIED, SETTINGS_CHANGED
  performedByUserId Int?
  performedByName  String
  role             String
  targetRecordId   String?
  targetRecordType String?
  description      String
  ipAddress        String?
  createdAt        DateTime @default(now())

  @@map("audit_logs")
}

model OwnerSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("owner_settings")
}

model AdminPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String   // e.g. "VIEW_MEMBERS", "ADD_MEMBER", etc.
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@map("admin_permissions")
}

model Enquiry {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String
  source     String?  // Walk-in, Website, Referral, Social Media, Phone
  status     String   @default("Pending") // Pending, FollowUp, Converted, Closed
  notes      String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("enquiries")
}

model Complaint {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberName  String
  subject     String
  description String
  priority    String   @default("Medium") // Low, Medium, High, Urgent
  status      String   @default("Open") // Open, In Progress, Resolved, Closed
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

model WorkoutPlan {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  goal        String
  level       String   @default("Beginner") // Beginner, Intermediate, Advanced
  duration    String   @default("4 Weeks")
  daysPerWeek Int      @default(4)
  exercises   String   // JSON string storing exercise routine
  isCustom    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("workout_plans")
}

model WebsiteTrainer {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  role           String
  img            String
  experience     String
  skills         String   // JSON array of strings
  certifications String   // JSON array of strings
  achievements   String   // JSON array of strings
  bio            String
  email          String
  phone          String?  @default("")
  socialLinks    String?  // JSON string
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("website_trainers")
}

model WebsiteGalleryItem {
  id        String   @id @default(cuid())
  category  String   // 'Workout', 'Trainers', 'Equipment', etc.
  title     String
  src       String
  caption   String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
  @@index([isActive])
  @@map("website_gallery_items")
}

model WebsitePricingPlan {
  id          String   @id @default(cuid())
  planId      String   @unique // 'monthly', 'quarterly', 'half_yearly', 'yearly', or custom
  title       String
  price       String
  period      String
  subtitle    String
  savings     String?  @default("")
  popular     Boolean  @default(false)
  badge       String?  @default("")
  gradient    String   @default("from-gray-600 to-gray-800")
  buttonText  String   @default("Join Now")
  buttonLink  String   @default("/#contact")
  features    String?  // Optional JSON array of plan-specific features
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
  @@index([isActive])
  @@map("website_pricing_plans")
}

model WebsiteFAQ {
  id        String   @id @default(cuid())
  category  String   // 'General', 'Membership', 'Pricing', 'Trainers', 'Workout', etc.
  question  String
  answer    String
  popular   Boolean  @default(false)
  videoUrl  String?  @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([popular])
  @@index([order])
  @@index([isActive])
  @@map("website_faqs")
}

model WebsiteSectionContent {
  id         String   @id @default(cuid())
  sectionKey String   @unique // 'hero', 'programs', 'contact', 'amenities', 'footer'
  content    String   // JSON string storing section data
  updatedAt  DateTime @updatedAt

  @@map("website_section_contents")
}

model MediaUpload {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  altText      String?  @default("")
  folder       String   @default("general")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media_uploads")
}